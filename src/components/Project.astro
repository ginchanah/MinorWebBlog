---
const {
    title,
    imgSrc,
    imgAlt = '',
    pageLink = '',
} = Astro.props;
---

<article class="project">
    <div class="black-border border-radius box-shadow">

        <div class="white-heading">
            <h3>{title}</h3>
        </div>
    
        <div class="project-layout white-content">
            <figure class="photo black-border">
                <img src={imgSrc} alt={imgAlt} class="project-image" />
            </figure>


            <div class="project-short">
                <slot name="short" />
            </div>
    
            <a href={pageLink}>Visit the site!</a>
        
            <details class="project-details" name="projects">
                <summary class="project-toggle">
                    <div class="visually-hidden">
                        Read more
                    </div>
                </summary>
        
                <div class="project-long">
                    <slot name="long" />
                </div>
            </details>
        </div>
    </div>

</article>