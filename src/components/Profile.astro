---

<section class="profile white-on-green-container black-border box-shadow border-radius">
    <div class="white-heading">
        <h2>Profile</h2>
    </div>
    <div class="green-content">
        <figure class="photo black-border">
            <img src="/static/media/maja-2.png" alt="A picture of me, standing in front of a white wall. A standart portrait shot. But I look happy.">
        </figure>
        <div class="general-info">
            <p class="input name">Maja</p>
            <div class="flag-p-container">
                <div class="flag">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
                <p class="input level">Level 24</p>
            </div>
        </div>
        <div class="hearts-container" role="radiogroup" aria-label="Rating">
            <button class="heart" data-value="1" role="radio" aria-checked="false" aria-label="1 out of 5"></button>
            <button class="heart" data-value="2" role="radio" aria-checked="false" aria-label="2 out of 5"></button>
            <button class="heart" data-value="3" role="radio" aria-checked="false" aria-label="3 out of 5"></button>
            <button class="heart" data-value="4" role="radio" aria-checked="false" aria-label="4 out of 5"></button>
            <button class="heart" data-value="5" role="radio" aria-checked="false" aria-label="5 out of 5"></button>
        </div>

        <div class="skills-container">
            <div class="skill css">
                <h3>CSS</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
            <div class="skill html">
                <h3>HTML</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
            <div class="skill accessibility">
                <h3>Web Toegankelijkheid</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
            <div class="skill javascript">
                <h3>JavaScript</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
            <div class="skill astro">
                <h3>Astro</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
            <div class="skill wordpress">
                <h3>Wordpress/PHP</h3>
                <div class="skill-slider">
                    <div></div>
                    <div></div>
                </div>
            </div>
        </div>
    </div>
</section>