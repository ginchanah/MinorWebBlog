---
---

<section class="profile white-on-green-container black-border box-shadow">
    <div class="white-heading">
        <h2>Profile</h2>
    </div>
    <div class="green-content">
        <figure class="photo black-border">
            <img src="/static/media/maja-2.png" alt="A picture of me, standing in front of a white wall. A standart portrait shot. But I look happy.">
        </figure>
        <div class="general-info">
            <p class="input name">Maja</p>
            <div class="flag-p-container">
                <div class="flag">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
                <p class="input level">Level 24</p>
            </div>
        </div>
        <div class="hearts-container" aria-label="my current health stats represented by hearts.">
            <button class="heart" data-value="1" aria-label="1 out of 5"></button>
            <button class="heart" data-value="2" aria-label="2 out of 5"></button>
            <button class="heart" data-value="3" aria-label="3 out of 5"></button>
            <button class="heart" data-value="4" aria-label="4 out of 5"></button>
            <button class="heart" data-value="5" aria-label="5 out of 5"></button>

            <!-- heart value -->
            <input type="hidden" name="rating" id="rating-value" value="0" />
        </div>
        <p>hihihi</p>
    </div>
</section>